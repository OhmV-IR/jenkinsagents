# Copy to .env next to docker-compose.yml and fill in. .env is git-ignored.
# Name and secret of the agent node, from Jenkins > Manage Jenkins > Nodes > <node>.
AGENT_NAME=new-laptop-container
AGENT_SECRET=
# Perforce through Cloudflare Access (cloudflared relay in the agent). The hostname is the tunnel's public hostname
# whose service is tcp://<p4 server>:1666, protected by a self-hosted Access application with a
# Service Auth policy that allows this service token (Zero Trust > Access > Service auth).
P4_ACCESS_HOSTNAME=
P4_ACCESS_CLIENT_ID=
P4_ACCESS_CLIENT_SECRET=
