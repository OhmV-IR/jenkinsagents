# Copy to .env next to docker-compose.yml and fill in. .env is git-ignored.
# Name and secret of the agent node, from Jenkins > Manage Jenkins > Nodes > <node>.
AGENT_NAME=new-laptop-linux-container
AGENT_SECRET=
# Cloudflare Zero Trust enrolment for the warp sidecar (see ../warp/example.env).
WARP_TEAM_NAME=
WARP_CLIENT_ID=
WARP_CLIENT_SECRET=
