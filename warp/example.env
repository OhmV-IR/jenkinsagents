# Copy to .env next to the docker-compose.yml that uses the warp sidecar and fill in. .env is git-ignored.
# Zero Trust team name, and a service token (Zero Trust > Access > Service auth) that the device enrolment
# policy allows. The private CIDR route to the Perforce server must be in the tunnel's routes and
# not excluded in the device profile's Split Tunnels.
WARP_TEAM_NAME=
WARP_CLIENT_ID=
WARP_CLIENT_SECRET=
